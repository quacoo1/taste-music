# Taste needs no environment variables. Nothing here is required, locally or on Vercel.
#
# AI keys are NOT configured here: each person connects their own AI provider
# in the app (AI integrations), and the key stays in their browser.

# Optional site-wide defaults for the export integrations. Anyone can still paste
# their own client ID in the app, which overrides these.
#   Spotify:  redirect URI to register → https://<your-domain>/callback  (locally: http://127.0.0.1:5199/callback)
#   Google:   authorized JavaScript origin → https://<your-domain>        (locally: http://127.0.0.1:5199)
SPOTIFY_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Local server only
HOST=127.0.0.1
PORT=5199
