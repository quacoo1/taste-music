{
  "name": "taste-music",
  "private": true,
  "version": "0.1.0",
  "description": "Plant a few songs, grow a playlist with one mood and seamless transitions. Export to Spotify and YouTube Music.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./src server/index.ts",
    "build": "vite build",
    "build:vercel": "vite build && node scripts/build-vercel.mjs",
    "start": "tsx server/index.ts --prod",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": "24.x"
  }
}
